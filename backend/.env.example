# ==========================================
# EventHub Unified Environment Variables
# ==========================================

# 1. Server Port (PaaS hosts like Render/Railway set this automatically; defaults to 5000)
PORT=5000

# 2. Node Environment
NODE_ENV=production

# 3. JWT Signing Key (Change to your own strong secret key in production)
JWT_SECRET=super_secret_college_eventhub_jwt_key_2026

# 4. Frontend API Endpoint
# - For unified VPS / single runner deployment (start.js), keep as /api so requests go to the same host:
VITE_API_BASE_URL=/api
# - If developing locally with separate Vite dev server: http://localhost:5000/api

# 5. Node Engine Version (Optional on platforms like Render to enforce Node 22)
NODE_VERSION=22

