{
  "name": "eventhub-college-portal",
  "version": "1.0.0",
  "description": "EventHub - Centralized College Event Management Web Application",
  "type": "module",
  "scripts": {
    "start": "node start.js",
    "build": "npm --prefix frontend run build",
    "backend": "npm --prefix backend start",
